ANTHROPIC_API_KEY=your-anthropic-api-key-here
CRM_API_URL=http://localhost:3000
CRM_API_TOKEN=your-crm-token-here

# Mission 3 Phase 2 — V3 categorization rollout
AI_REVIEW_FORMAT=v3                    # 'v2' | 'v3' — default 'v3' with V2 soft fallback on V3 failure
AI_REVIEW_CONFIDENCE_THRESHOLD=0.7     # bucketConfidence below this triggers keyword fallback
AI_REVIEW_DEBUG=false                  # set 'true' for verbose ai-review logging
