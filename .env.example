# Anthropic API (used for AI inspection analysis)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# AI review behavior
AI_REVIEW_FORMAT=v3                    # 'v2' | 'v3' — default 'v3' with V2 soft fallback
AI_REVIEW_CONFIDENCE_THRESHOLD=0.7     # bucketConfidence below this triggers keyword fallback
AI_REVIEW_DEBUG=false                  # set 'true' for verbose ai-review logging

# CRM login endpoint — used ONLY for the initial login POST. Once the user
# logs in, all authenticated calls use the serverWwwUrl returned in the
# login response (stored encrypted in credentials.bin). Default is the
# public CRM URL; override only for local dev against a localhost backend.
CRM_LOGIN_URL=https://www.keepsimplecrm.com

# Note: CRM_API_TOKEN and CRM_API_URL were removed in v1.1.0. Credentials
# are now obtained via the in-app login screen and stored in the user's
# profile directory. Distributed installers no longer ship a token.
